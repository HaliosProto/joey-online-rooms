{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joey-online-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "RoomDirectory" },
      { "name": "MATCH", "class_name": "DuelRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDirectory", "DuelRoom"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
